# Copy to .env for local development. Never commit .env.

# Required: TomTom Routing + Search (free key, no card: https://developer.tomtom.com)
TOMTOM_API_KEY=

# Required in production (any long random string)
DJANGO_SECRET_KEY=

# Optional
# DJANGO_DEBUG=1                 # local development
# FAKE_ROUTING=1                 # local/E2E only: synthetic routes, ignored unless DEBUG
# REDIS_URL=redis://...          # shared cache across serverless instances
# OPEN_METEO_API_KEY=            # paid Open-Meteo plan (uses customer-api.open-meteo.com)
# OPEN_METEO_BASE_URL=https://api.open-meteo.com
